{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "allowImportingTsExtensions": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "isolatedModules": true
  },
  "include": ["src", "tests", "*.ts"]
}
